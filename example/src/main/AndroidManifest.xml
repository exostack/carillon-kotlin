<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    API 33 and above. Asking for it needs an activity, so it is the app's call
    rather than the SDK's: the SDK reads the answer and reports DENIED.
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application android:label="Carillon Example">
    <activity android:name=".MainActivity" android:exported="true"
        android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      The bench's own service rather than the SDK's, deliberately: it exercises
      the second documented integration — an app that already has a
      FirebaseMessagingService keeps it and forwards two calls to Carillon.
      Firebase dispatches to one service per application, so declaring both
      would mean one of them silently never runs. It is also what lets the
      bench display and log foreground deliveries, which are the app's
      business and which the system never shows on its own.
    -->
    <service
        android:name=".ExampleMessagingService"
        android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
